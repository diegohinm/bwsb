# ── bwsb backend environment ─────────────────────────────────────────────────
# Server-side only. Never expose these values to the frontend. Do not commit the
# real .env file.
#
# TWO PROCESSES SHARE THIS REPO (see render.yaml):
#   bwsb-api     SERVICE_ROLE=api     npm start        HTTP; reads DB snapshots.
#                                                      Needs NO provider keys.
#   bwsb-worker  SERVICE_ROLE=worker  npm run worker   No HTTP; calls Mindcase +
#                                                      Databento on a schedule and
#                                                      writes snapshots. THIS is
#                                                      the only service that needs
#                                                      MINDCASE_* / DATABENTO_*.
# Locally, SERVICE_ROLE=all (the default) lets a single process do both, so
# `npm run dev` works on its own; run `npm run dev:worker` for real ingestion.

PORT=4000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# api | worker | all
SERVICE_ROLE=all

# Supabase REST client (existing tickers feature).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# App database (raw pg pool + Prisma + auth tables). Postgres connection string.
DATABASE_URL=

# Session signing secret (min 16 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SESSION_SECRET=

# ── Email (verification links + password resets) ─────────────────────────────
#
# Gmail / Google Workspace, in short:
#   1. Turn on 2-Step Verification for the account:
#        https://myaccount.google.com/signinoptions/twosv
#   2. Create an App Password ("Mail" → your device):
#        https://myaccount.google.com/apppasswords
#   3. Google shows 16 characters as four groups ("abcd efgh ijkl mnop").
#      Paste them into SMTP_PASSWORD. Spaces are stripped automatically, but
#      writing them without spaces is clearer.
#   4. Restart the backend — .env is read once at startup.
#
# SMTP_PASSWORD MUST BE AN APP PASSWORD, NOT THE ACCOUNT PASSWORD. Gmail answers
# `535-5.7.8 Username and Password not accepted` to a normal password even when
# it is correct.
#
# Port and TLS go together: 465 → SMTP_SECURE=true, 587 → SMTP_SECURE=false.
# Leave SMTP_SECURE blank and the right value is derived from the port.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
# Shown as the sender. Defaults to SMTP_USER. With Gmail this must be the
# authenticated account (or an alias it is allowed to send as) — an unrelated
# address is either rewritten or rejected.
SMTP_FROM=

# When true (or when SMTP is not configured) verification/reset links are printed
# to the backend console instead of being emailed. Must be false in production.
# Set it to false to actually exercise SMTP locally.
DEV_EMAIL_MODE=true

# ── Reddit OAuth 2.0 (OPTIONAL / future) ─────────────────────────────────────
# Leave blank to run without Reddit login. When you are ready, create a "web app"
# at https://www.reddit.com/prefs/apps and fill these in. The app starts fine
# without them; /auth/reddit returns 503 until all four are set to real values.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_REDIRECT_URI=http://localhost:4000/auth/reddit/callback
REDDIT_USER_AGENT=YOLOPulse/0.1 by YOUR_REDDIT_USERNAME

# ── Optional Reddit username verification (inbound message flow) ──────────────
# The Reddit account users send their verification code to (inbound only — the
# app never sends DMs). Admin reviews the inbox and approves via ADMIN_SECRET.
REDDIT_VERIFICATION_USERNAME=yolo-terminal
ADMIN_SECRET=

# ── Google OAuth 2.0 (OPTIONAL) ──────────────────────────────────────────────
# Leave blank to run without Google login. When ready, create OAuth credentials
# (type: "Web application") at https://console.cloud.google.com/apis/credentials
# and add the redirect URI below to the client's "Authorized redirect URIs".
# The app starts fine without them; /auth/google returns 503 and the frontend
# shows the Google button disabled until all values are real. The client secret
# is server-side only and is NEVER sent to the frontend.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback

# ── Social data provider (Reddit-like posts/comments/pulse) ──────────────────
# The app never scrapes Reddit. Social data comes from a swappable third-party
# provider queried server-side, or from centralized local demo fixtures.
#   mock | mindcase | brandwatch | reddit_official | off
# `off` disables the Pulse data feed and demo data is served with a warning.
# A real provider without its API key automatically falls back to mock and the
# response is flagged isMock=true with a warning.
SOCIAL_DATA_PROVIDER=mock

# Seconds a social payload is cached before the provider is queried again.
# Also prevents a page refresh from starting a new upstream job. Past this TTL
# the payload stays readable as "stale" for a while, so a rate-limited provider
# is answered with last-known-good data instead of an error.
SOCIAL_DATA_CACHE_TTL_SECONDS=600

# Third-party provider credentials. Backend-only — never sent to the frontend.
# When SOCIAL_DATA_PROVIDER=mindcase, both must be set or the provider reports
# "misconfigured" and the app serves mock fallback.
MINDCASE_API_KEY=
# Versioned API root. The Reddit provider appends /api/v1 when it is missing,
# so both forms work and neither produces /api/v1/api/v1/... on the wire.
MINDCASE_BASE_URL=https://api.mindcase.co/api/v1

# ── Mindcase rate-limit guards (429 protection) ──────────────────────────────
# Mindcase is metered: too many parallel jobs or too-frequent result polls earn
# HTTP 429. These bound how hard the backend may push it. All optional — the
# values below are also the code defaults. If you still see 429s, set
# MINDCASE_MAX_CONCURRENCY=1.
#
# How many subreddits may be fetched at the same time (never unbounded).
MINDCASE_MAX_CONCURRENCY=2
# Minimum delay between two GET /jobs/{id}/results polls, in ms.
MINDCASE_POLL_INTERVAL_MS=3000
# Max result polls per job before that subreddit is given up on.
MINDCASE_MAX_POLLS=10
# Retries after a 429/5xx. A 429 honours Retry-After, else backs off 2s/4s/8s.
MINDCASE_MAX_RETRIES=3

# WORKER ONLY — how often the ingestion jobs run.
# Seconds between social ingestion runs (Mindcase → social_posts + pulse snapshots).
SOCIAL_DATA_REFRESH_SECONDS=600
# Seconds between trending ticker-strip snapshots (DB-only job, no provider calls).
TICKER_STRIP_REFRESH_SECONDS=300

# ── Admin access ─────────────────────────────────────────────────────────────
# There is no role column on app_users: accounts are email-identified and
# otherwise equal. These two variables are the ONLY things that grant admin.
#
# ADMIN_SECRET  shared secret sent as the `x-admin-secret` header. For curl and
#               server-to-server only — never put it in a browser.
# ADMIN_EMAILS  comma-separated allowlist. A SIGNED-IN user whose email is on it
#               is an admin, which is what lets internal PAGES (the Reddit
#               scanner at /admin/reddit-scanner) work in production without
#               shipping a secret to the client.
#
# Empty means NOBODY is an admin and internal pages are development-only.
# Forgetting to set this closes the door rather than opening it.
ADMIN_SECRET=
ADMIN_EMAILS=

# ── Reddit data providers (Mindcase / Arctic Shift) ──────────────────────────
# Feeds `reddit_posts` / `reddit_comments`, the tables the bet-extraction
# pipeline reads. Independent of SOCIAL_DATA_PROVIDER above, which feeds the
# Subreddit Pulse aggregation.
#
# Switching provider is an EDIT TO THIS FILE and nothing else. Only the worker
# ever calls an upstream; the API and the frontend always read PostgreSQL.
#
# REDDIT_DATA_MODE:
#   mindcase      only Mindcase. Arctic Shift is never contacted.
#   arctic_shift  only Arctic Shift. Mindcase is never contacted. (code default)
#   hybrid        both, in parallel; results merged and de-duplicated by Reddit id.
#   fallback      the primary; the secondary only when the primary fails, times
#                 out, returns 429/5xx, or returns nothing.
REDDIT_DATA_MODE=hybrid

# Used by `fallback` (and to decide which provider wins `source` on a record
# that both returned in `hybrid`). The two MUST be different.
REDDIT_PRIMARY_PROVIDER=arctic_shift
REDDIT_FALLBACK_PROVIDER=mindcase

# Master switches. A provider set to false is never constructed, so no code path
# can reach it. The mode must be consistent with these: REDDIT_DATA_MODE=mindcase
# with REDDIT_ENABLE_MINDCASE=false is refused at startup.
REDDIT_ENABLE_MINDCASE=true
REDDIT_ENABLE_ARCTIC_SHIFT=true

# Shared HTTP budget for both providers.
# Timeout per attempt; retries AFTER the first attempt; base backoff (a 429
# honours Retry-After, otherwise 5s → 10s → 20s, capped at 30s).
REDDIT_PROVIDER_TIMEOUT_MS=30000
REDDIT_PROVIDER_MAX_RETRIES=3
REDDIT_PROVIDER_RETRY_DELAY_MS=5000

# Collapse records both providers returned into one (keep this on — it is what
# prevents duplicate rows) and keep the upstream payload in raw_data.
REDDIT_DEDUPLICATE_RESULTS=true
REDDIT_STORE_SOURCE_METADATA=true
# In `fallback` mode, treat an empty primary result as a reason to fall back.
REDDIT_FALLBACK_ON_EMPTY=true

# Mindcase. Same credentials as the social provider above; both are optional
# when REDDIT_ENABLE_MINDCASE=false. Backend-only — never sent to the frontend.
# MINDCASE_API_KEY / MINDCASE_BASE_URL are set in the social section above.
# Delay between two GET /jobs/{id}/results polls, and how many polls per job.
MINDCASE_POLL_INTERVAL_MS=5000
MINDCASE_MAX_POLL_ATTEMPTS=20

# Arctic Shift — a public Reddit archive. No API key. It is a free community
# service, so requests are deliberately spaced.
ARCTIC_SHIFT_BASE_URL=https://arctic-shift.photon-reddit.com
ARCTIC_SHIFT_REQUEST_DELAY_MS=1000

# ── THE subreddit list ────────────────────────────────────────────────────────
# ONE variable for every provider (Arctic Shift, Mindcase, hybrid, fallback).
# There is deliberately no ARCTIC_SHIFT_SUBREDDITS / MINDCASE_SUBREDDITS: the
# communities belong to the product, not to an upstream.
#
# Accepts `wallstreetbets`, `r/stocks` or a full reddit.com URL; names are
# lowercased and de-duplicated. THE ORDER IS THE WORKER'S ROTATION ORDER.
# Changes to REDDIT_SUBREDDITS require a worker restart.
REDDIT_SUBREDDITS=wallstreetbets,stocks,options,investing,pennystocks

# ── Arctic Shift paced worker ────────────────────────────────────────────────
# ONE request every five minutes for the WHOLE system, rotating through the list
# above: 12 requests/hour, each community roughly every 25 minutes with five of
# them. This is the budget Arctic Shift gets from YOLOPulse — it is a free
# community archive with no quota page and no key.
#
# Off by default. When true it REPLACES the generic Reddit ingestion job
# (REDDIT_INGESTION_ENABLED), which fetches every subreddit per run and would
# break the pacing promise.
ARCTIC_SHIFT_ENABLED=false
# 300000 ms = 5 minutes. This is a FLOOR: a smaller value is raised back to it.
REDDIT_POLL_INTERVAL_MS=300000
# Records per request. Arctic Shift caps a search response at 100; a full page
# means "there is more", which is read on that subreddit's NEXT turn, never with
# an extra request now.
REDDIT_POST_LIMIT=100
# First run for a subreddit looks back this far; afterwards the cursor decides.
REDDIT_INITIAL_LOOKBACK_MINUTES=30
# The window re-reads this much before the cursor, because an archive can index
# a post late. The resulting duplicates are collapsed by Reddit id.
REDDIT_CURSOR_OVERLAP_SECONDS=120
# Abort one request after this long. There are NO HTTP retries in the worker: a
# timeout waits for the next five-minute slot like any other failure.
ARCTIC_SHIFT_REQUEST_TIMEOUT_MS=30000
# CONSECUTIVE failed cycles for one subreddit before it is cooled down for 15
# minutes. NOT immediate retries — those would break the request budget.
ARCTIC_SHIFT_MAX_RETRIES=3
ARCTIC_SHIFT_RETRY_BASE_DELAY_MS=5000

# WORKER ONLY. Off by default: deploying this code must not silently start
# spending provider quota. Set to true to schedule the ingestion job.
REDDIT_INGESTION_ENABLED=false
REDDIT_INGESTION_REFRESH_SECONDS=900
# Also ingest comments. One provider call PER POST — leave off unless needed.
REDDIT_INGEST_COMMENTS=false

# ── Market data provider (equities + overnight) ──────────────────────────────
# Fully separate from the social provider above. Provider keys are read only by
# the backend and never sent to the frontend.
#
# INTENTIONALLY MINIMAL: the six vars below are the ONLY market-data settings.
# Base URL, equities/overnight/options schemas, the options dataset, symbology
# types and the live/real-time/overnight PUBLIC toggles are internal code
# defaults — see bwsb/src/services/market-data/providers/databento.config.ts.
#   mock | databento | polygon | alpaca | twelvedata
MARKET_DATA_PROVIDER=databento
# Safe display mode: mock | delayed | realtime | end_of_day. `delayed` is the
# default and data is never presented as real-time in safe mode.
MARKET_DATA_MODE=delayed
MARKET_DATA_CACHE_TTL_SECONDS=10
# How far behind real-time the published data is. Stamped on every worker-written
# quote/mover row and rendered by the UI as "Delayed 15m".
MARKET_DATA_DELAY_MINUTES=15

# ── Extended hours (premarket / after-hours / overnight) ─────────────────────
# Master switch. FALSE (default) = the product works ONLY with the US regular
# session, 09:30-16:00 America/New_York:
#   - the worker never requests overnight/extended data from Databento;
#   - premarket / after-hours / overnight snapshots are not persisted;
#   - the API only serves session="regular" rows and rejects ?session=overnight;
#   - outside market hours the last regular-session close is returned, labeled
#     as such and never presented as a live quote.
# The implementation is kept behind this flag, not deleted. Set to true to
# restore every extended-hours path (frontend: VITE_ENABLE_EXTENDED_HOURS).
ENABLE_EXTENDED_HOURS=false

# WORKER ONLY — ingestion cadence for market data. Quotes come from the
# HISTORICAL API (delayed mode never opens a live stream): one run pulls bars for
# the whole watchlist and takes ~40-80s, and the dataset republishes about once a
# day, so polling faster than this just burns quota.
MARKET_DATA_REFRESH_SECONDS=300
MARKET_MOVERS_REFRESH_SECONDS=60

# ── Databento — backend-only credentials ─────────────────────────────────────
# App runs fine with a blank key (status "misconfigured" → mock fallback with a
# warning; never crashes). The two datasets default in code if left blank.
DATABENTO_API_KEY=db_TU_API_KEY_REAL
DATABENTO_DATASET=EQUS.MINI
DATABENTO_OVERNIGHT_DATASET=OCEA.MEMOIR

# ── Mindcase ingestion cadence + cost control ────────────────────────────────
#
# MINDCASE BILLS PER ROW RETURNED, about $0.005 each. NOT per request: a response
# of 50 rows you already stored costs exactly what 50 new ones cost. So counting
# HTTP requests measures nothing that reaches the invoice, and deduplicating in
# Postgres saves correctness, not money. The only lever that lowers the bill is
# the provider RETURNING FEWER ROWS.
#
# The agent has NO server-side time filter — no after/since/cursor/page/offset.
# It crawls a Reddit listing URL and returns the newest N. "Incremental" here
# therefore means: ask for the smallest N that plausibly covers what changed,
# and stop at the first id already stored.
#
# WHAT THIS REPLACED: a sweep over all five REDDIT_SUBREDDITS at 50 rows each,
# every 10 minutes — 250 billable rows/cycle, ~36,000/day, ~$180/day — for
# content of which only wallstreetbets was ever displayed.

# ── THE SINGLE SOURCE OF TRUTH FOR ACTIVE COMMUNITIES ────────────────────────
#
# ONE VARIABLE, HERE, CONTROLS EVERYTHING:
#
#   REDDIT_ACTIVE_COMMUNITIES
#        ├─ backend   Discussion, search, summary, Top/Hot tickers
#        ├─ worker    which subreddits Mindcase is ever asked about
#        └─ frontend  which communities exist, and whether a selector renders
#
# The worker reads it from GET /internal/runtime-config (authenticated with
# WORKER_INTERNAL_SECRET); the frontend from GET /api/runtime-config. NEITHER has
# a variable of its own — no VITE_REDDIT_COMMUNITIES, no worker list. Three
# places to configure one fact is three chances to disagree, and the way they
# disagreed is what sent r/options to a metered provider.
#
# SUPPORTED != ACTIVE. REDDIT_SUBREDDITS above stays as the catalog of
# communities the product KNOWS ABOUT (multi-community support is not removed,
# and historical data is not deleted). This is the list it currently READS and
# PAYS FOR.
#
# CSV, normalized: trimmed, lowercased, `r/` stripped, duplicates removed.
#   wallstreetbets
#   r/wallstreetbets
#   WallStreetBets, r/options
# An unsupported name FAILS STARTUP rather than being ignored — a silently
# dropped typo would activate fewer communities than the operator believes.
# Unset falls back to wallstreetbets alone, NEVER to the full supported list:
# a missing line must not become eight metered subreddits.
REDDIT_ACTIVE_COMMUNITIES=wallstreetbets

# Posts only discover threads; nobody watches for one to appear within seconds.
REDDIT_POSTS_INTERVAL_MINUTES=10

# Comments, market-aware. One minute is an incremental attempt on a few active
# threads — NOT a reload of the subreddit. Market state comes from
# services/market/usMarketCalendar (holidays, early closes, DST), never from a
# market-data provider.
REDDIT_COMMENTS_MARKET_OPEN_INTERVAL_MINUTES=1
REDDIT_COMMENTS_MARKET_CLOSED_INTERVAL_MINUTES=10

# UPPER BOUNDS on rows per request. The adaptive sizer asks for less when the
# last sync found little, so these are ceilings, not the steady state — a quiet
# stream converges to REDDIT_MIN_FETCH_LIMIT.
REDDIT_POSTS_FETCH_LIMIT=25
REDDIT_COMMENTS_FETCH_LIMIT=20
# Floor. Below ~10 rows the boundary check cannot distinguish "nothing new" from
# "the page was too short to reach the boundary".
REDDIT_MIN_FETCH_LIMIT=10

# Seconds of overlap re-requested around the checkpoint, so items sharing a
# second with it are not dropped. Seconds — not the half hour the old watermark
# effectively used, which is what gave back the entire saving.
REDDIT_SYNC_OVERLAP_SECONDS=30

# Hard caps. TWO, not five: each extra page is another full page of billable
# rows, and a high cap turns one bad day into a large invoice.
REDDIT_MAX_PAGES_PER_SYNC=2
REDDIT_MAX_PAGES_PER_CATCHUP=3

# How many threads one comment sweep may touch, and how many empty syncs retire
# a thread. Together these bound a sweep at threads x limit rows and stop the
# rotation growing without bound as threads accumulate.
REDDIT_COMMENT_THREADS_PER_SYNC=2
REDDIT_THREAD_IDLE_RUNS=5

# ── Mindcase budget guard ────────────────────────────────────────────────────
# SAFETY LIMITS, NOT SPEND TARGETS. They exist so a bug cannot produce an
# unbounded invoice. Crossing one pauses INGESTION ONLY: the API, Discussion,
# search, Top and Hot Tickers keep serving from Postgres, data just stops getting
# fresher. Enforced against a database ledger (mindcase_usage_events), because an
# in-process counter resets on deploy and a crash-loop would have no ceiling.
# 0 means unlimited; to stop calling Mindcase entirely use SOCIAL_DATA_PROVIDER=off.
MINDCASE_COST_PER_RESULT_USD=0.005
MINDCASE_MAX_ROWS_PER_HOUR=2000
MINDCASE_MAX_ROWS_PER_DAY=10000
MINDCASE_MAX_ESTIMATED_COST_PER_DAY_USD=50

# ── Reddit / market separation ───────────────────────────────────────────────
# Reddit analytics and market data are two independent pipelines. Reddit content
# is ingested, extracted, aggregated and served entirely from Postgres; Databento
# is a separate, queued enrichment layer. WITH DATABENTO COMPLETELY OFFLINE,
# Discussion, search, Top Tickers, Hot Tickers, sentiment and Daily Discussion
# all keep working — only prices go stale. The variables below tune that split.
#
# All four flags are MIGRATION switches and all four default to the NEW
# behaviour: a fresh environment needs none of them set. They exist so one
# switchover can be reversed without a deploy, and they are meant to be deleted
# once each path has run unattended for a while.

# Serve Top/Hot Tickers from the pre-aggregated ticker_activity buckets instead
# of scanning the association tables on every request.
#
# SET THIS TO false WHILE BACKFILLING. Buckets do not exist for history that has
# not been processed yet, so a half-filled table reports a real-looking ranking
# with the older part of the window missing. Run
#   npm run backfill:reddit -- --from=2026-08-01
# first, then turn it back on.
DISCUSSION_USE_AGGREGATIONS=true

# Minimum mentions in the CURRENT window before a ticker may be ranked "hot".
# This sets the 24-hour floor; shorter and longer windows are fixed ratios of it
# (1h=2/5, 6h=3/5, 7d=×2, 30d=×4), so one number moves the whole curve.
# Without a floor, hotness degenerates into symbols that went from 1 mention to 3.
# 0 disables the guard — useful on an empty development database, wrong in prod.
HOT_TICKERS_MIN_MENTIONS=5

# Whether the API may enqueue market-data refresh jobs and the worker consume
# them. Off, the worker falls back to refreshing its fixed symbol list on a
# timer; reads still serve whatever snapshots exist, so nothing breaks.
MARKET_DATA_QUEUE_ENABLED=true

# Serve a stale quote immediately and refresh it in the background, rather than
# making the reader wait for a provider round-trip.
# The API NEVER blocks on Databento either way — this only decides whether a
# read is allowed to SCHEDULE a refresh for whoever looks next.
MARKET_STALE_WHILE_REVALIDATE=true

# How old a stored quote may be, during market hours, before a read asks for a
# refresh. NOT how old it may be before it stops being served: a stale quote
# labeled as stale beats an empty panel.
QUOTE_TTL_SECONDS=30
VOLUME_TTL_SECONDS=60

# Symbols per upstream request. A starting point, not a provider limit — the
# worker clamps to whatever the configured provider actually accepts, so twenty
# queued symbols cost ONE Databento request rather than twenty.
MARKET_DATA_BATCH_SIZE=50

# WORKER: how often the market-data queue is drained, and how many jobs one
# drain may claim (which bounds a single run's provider spend).
MARKET_QUEUE_POLL_SECONDS=20
MARKET_QUEUE_BATCH_LIMIT=200

# ── Seed ─────────────────────────────────────────────────────────────────────
# Whether `npm run db:seed` may write DEVELOPMENT/DEMO content: fake users,
# bets, portfolios, social posts and mock market quotes.
#
# false (default) → only reference data is seeded: the ticker catalog and the
#                   default paper-trading season. Nothing fake is created.
# true            → also inserts demo content, every row marked mock/seeded.
#
# Ignored entirely when NODE_ENV=production: demo data can never be written to
# a production database, whatever this says.
SEED_DEMO_DATA=false

# ── Ticker catalog (US market symbol universe) ───────────────────────────────
#
# A daily import of the official symbol directories into the `tickers` table.
# Three public files, no API key, no quota — which is why it defaults to ON.
#
#   nasdaqlisted.txt  Nasdaq equities and ETFs        (QQQ, NVDA, MSFT, RDDT)
#   otherlisted.txt   NYSE / NYSE American / NYSE Arca / Cboe BZX / IEX
#                                                     (SPY, IWM, IBM, AI)
#   Cboe indices JSON Index products                  (SPX, VIX, RUT, XSP)
#
# SOURCES ARE ISOLATED. Each one refreshes only the rows it owns, so a Cboe
# outage cannot retire the equity universe and a Nasdaq outage cannot retire
# SPX. A source that fails to download, parse or validate changes NOTHING.
# Symbols that leave a directory are marked inactive, never deleted.
TICKER_CATALOG_ENABLED=true
NASDAQ_LISTED_SOURCE_URL=https://www.nasdaqtrader.com/dynamic/SymDir/nasdaqlisted.txt
OTHER_LISTED_SOURCE_URL=https://www.nasdaqtrader.com/dynamic/SymDir/otherlisted.txt
# Separately switchable: it is the one source outside Nasdaq Trader, so if Cboe
# moves the endpoint this can be turned off without stopping the equity import.
CBOE_INDEX_CATALOG_ENABLED=true
CBOE_INDEX_CATALOG_SOURCE_URL=https://cdn.cboe.com/api/global/us_indices/definitions/all_indices.json
# 86400000 ms = 24 hours. Reference data, not market data.
TICKER_CATALOG_REFRESH_INTERVAL_MS=86400000
TICKER_CATALOG_REQUEST_TIMEOUT_MS=30000
# Manual run (works even when TICKER_CATALOG_ENABLED=false):
#   npm run ticker-catalog:refresh
